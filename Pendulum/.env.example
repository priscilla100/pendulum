# Pendulum configuration. Copy to .env and edit.
# Every knob the pipeline reads is here. Real environment variables override
# this file. Relative paths resolve against Pendulum/.

# Global agent defaults. Every agent inherits these unless its own
# <PREFIX>_<FIELD> key is set. Prefixes:
#   AP_      atomic-proposition extractor
#   ORCH_    orchestrator (filter, AP fallback, final determination)
#   PYTHON_  PYTHON_TO_LTL synthesis agent
#   DWYER_   DWYERS_APPROACH_TO_LTL synthesis agent
#   SALT_    SALT_TO_LTL synthesis agent
#   ONESHOT_ ONESHOT_TO_LTL synthesis agent (optional; off by default)
#   FUZZY_   fuzzy formula-verification agent
#   DET_     deterministic (BLACK-tool) verification agent
# Fields: BASE_URL, API_KEY, MODEL, TEMPERATURE, NUM_CTX, MAX_STEPS,
#         TIMEOUT_S, MAX_RETRIES, THINKING, STREAMING
# Any <PREFIX>_<FIELD> combination of the above is valid; only a few are
# spelled out below.
PENDULUM_DEFAULT_BASE_URL=http://localhost:11434/v1
PENDULUM_DEFAULT_API_KEY=ollama            # any non-empty string for local servers
PENDULUM_DEFAULT_MODEL=gemma4:31b-mlx      # every seat inherits this unless overridden below
PENDULUM_DEFAULT_TEMPERATURE=0.0
PENDULUM_DEFAULT_NUM_CTX=16384             # context window size
PENDULUM_DEFAULT_MAX_STEPS=8               # max tool-call iterations per agent run
PENDULUM_DEFAULT_TIMEOUT_S=480             # expiration time per agent invocation
PENDULUM_DEFAULT_MAX_RETRIES=2
PENDULUM_DEFAULT_THINKING=false            # request reasoning/thinking mode if the model supports it
PENDULUM_DEFAULT_STREAMING=false           # stream completions (visible in debug logs)

# Per-agent overrides. Uncomment to swap a specific seat, e.g.:
#ORCH_MODEL=qwen3.6:27b                     # a heavier orchestrator
#PYTHON_MODEL=qwen2.5-coder:32b-instruct    # a dedicated coding model for the AST trick
#ONESHOT_MODEL=qwen2.5-coder:32b-instruct   # cross-model one-shot path (needs PENDULUM_ONESHOT_ENABLED=true)
#ONESHOT_BACKEND=ollama                      # or codex-cli for a frontier one-shot arm
#DET_MODEL=qwen3:14b                        # a lighter deterministic verifier
#AP_TEMPERATURE=0.0

# Logging. Level applies to both the console and logs/<run_id>.jsonl.
#   debug   = everything: prompts, raw completions, tool args/results, cache hits
#   info    = stage progress, decisions, candidates, verdicts
#   warning = degradations (llama-server down, retries, fallbacks)
#   error   = failures
PENDULUM_LOG_LEVEL=info
PENDULUM_LOG_DIR=logs

# Pipeline behavior
# AP extraction falls back to the orchestrator when the extractor errors OR its
# LNLL confidence is below this threshold (mean token logprob; 0 is certain,
# more negative = less certain).
PENDULUM_AP_CONFIDENCE_THRESHOLD=-1.5

# If ALL candidates are refuted/errored in verification, loop back to synthesis
# once with the failure evidence attached.
PENDULUM_FEEDBACK_LOOP=true
PENDULUM_FEEDBACK_MAX_ROUNDS=1

# LNLL scope: 'formula' = confidence over just the emitted formula tokens
# (grammar-constrained calls emit only the formula, so this is exact there;
# JSON-envelope completions degrade to full-completion mean). 'full' = always
# the whole completion.
PENDULUM_LNLL_SCOPE=formula

PENDULUM_MAX_OUTPUT_FORMULAS=10            # cap AFTER survivor+variant expansion
# When the orchestrator judges ALL candidates refuted: true = emit the
# deterministic-fallback ranking flagged low_confidence in the message;
# false = honest empty refusal.
PENDULUM_EMIT_BEST_GUESS=true

# Feature toggles
PENDULUM_DWYER_ENABLED=false               # include the Dwyer pattern agent in the synthesis fan-out
PENDULUM_ONESHOT_ENABLED=false             # include the one-shot synthesizer in the fan-out
PENDULUM_DET_VERIFY_ENABLED=false          # run the deterministic (BLACK-tool) verifier alongside the fuzzy verifier
# Skip the LLM finalize agent and rank the final candidates purely from the
# verification verdicts. Set false to restore the LLM finalize agent.
PENDULUM_ORCH_DETERMINISTIC=true
# Give the orchestrator a code-side compare_candidates lattice (equivalence/
# entailment between candidates) for filtering and tie-breaks.
PENDULUM_ORCH_COMPARE_FILTER=false
# Emit every kept, not-fuzzy-refuted candidate in the final ranking (not just
# the orchestrator's chosen list).
PENDULUM_OUTPUT_ALL_SURVIVORS=true
# For each output formula also emit its G-wrapped / unwrapped counterpart
# (scope-ambiguous NL like "HREADY shall be high").
PENDULUM_OUTPUT_SCOPE_VARIANTS=true
PENDULUM_MAX_CANDIDATES_TO_VERIFY=5        # cap on verification fan-out
SYNTH_PARSE_MAX_RETRIES=3                  # parse-error feedback loop per synthesis agent
SYNTH_MAX_CANDIDATES=3                     # candidates each synthesis agent may emit per round
SALT_FIX_MAX_ATTEMPTS=4                    # SALT compile-error fix loop
PENDULUM_SALT_RAG_DISABLED=false           # run the SALT author with no retrieved reference (static prompt only)
# PYTHON_TO_LTL implementation: 'direct' = call the coding model ourselves
# (grammar + LNLL available); 'mcp' = delegate to the nl_to_ltl_via_python tool.
PYTHON_AGENT_MODE=direct

# llama-server (optional): grammar-constrained decoding + token logprobs.
# When disabled/down, formula emission falls back to the agent's own backend
# with validate-and-retry, and confidences become null.
LLAMACPP_ENABLED=true
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_HEALTH_TTL_S=30                   # health-probe cache
PENDULUM_GRAMMAR_FILE=../grammars/pltl.gbnf

# pltl-mcp tool server (spawned as a stdio child per run)
PENDULUM_MCP_BIN=../target/release/pltl-mcp
PLTL_PARSER_BIN=../ocaml/_build/default/main.exe
PLTL_TOOL_LLM_BASE_URL=http://localhost:11434   # helper LLM for the server's 3 LLM tools
PLTL_TOOL_LLM_MODEL=gemma4:31b-mlx              # e.g. ltl_to_nl paraphrases feed the audit judge
#BLACK_BIN=/opt/homebrew/bin/black          # unset = rely on PATH

# Client-side tool-result cache: DETERMINISTIC tools only (parse, salt compile,
# salt_help, the 8 BLACK solver tools). LLM-backed fuzzy tools are never cached.
PENDULUM_TOOL_CACHE=true
PENDULUM_TOOL_CACHE_SIZE=1024

# RAG (Dwyer property patterns + SALT manual)
PENDULUM_RAG_DIR=data/rag
PENDULUM_RAG_AUTOBUILD=true                # build missing indexes at pipeline start
RAG_EMBED_MODEL=all-minilm                 # via Ollama /api/embed
RAG_EMBED_BASE_URL=http://localhost:11434
RAG_TOP_K=4

# Eval
EVAL_USE_BLACK=true                        # semantic equivalence scoring after exact-match

# Verification judge.
# true (default): ONE contrastive, falsification-framed judge call per row —
# all candidates judged together with paraphrases, BLACK violating-trace
# "forbidden examples", and a compare_candidates relations block; output is
# JSON-schema-constrained. false: legacy per-candidate paraphrase match.
PENDULUM_CONTRASTIVE_JUDGE=true
# Per-paraphrase audit judge: instead of one holistic verdict, the judge
# checks each of a candidate's paraphrases against the requirement (anchored
# on the deterministic literal reading) and derives the verdict from the
# fraction that capture it. false: single-verdict judge.
PENDULUM_JUDGE_PARAPHRASE_AUDIT=true

# Per-agent backend: ollama (default) | claude-cli | codex-cli.
# CLI backends run the installed `claude` / `codex` programs as subprocesses
# (billing/auth via your CLI logins — no API keys in Pendulum). No logprobs
# (confidence null); grammar-constrained emission stays on llama-server.
# Model field rules for CLI backends: claude-cli passes --model only for
# sonnet|opus|haiku|claude-*; codex-cli only for gpt*/codex*/o<digit>* —
# any other value (e.g. an ollama model name) means "use the CLI default".
#FUZZY_BACKEND=claude-cli
#PYTHON_BACKEND=codex-cli
#CLAUDE_CLI_BIN=claude
#CODEX_CLI_BIN=codex

PENDULUM_OLLAMA_SEED=7                     # decoding seed for Ollama completions (temp-0 reproducibility)
